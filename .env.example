# --- AI provider keys used by app/backend/llm_client.py ---
# Add any ONE of these (free tiers work fine) to make /chat give real
# AI responses instead of an offline notice. Priority order: groq, gemini,
# openrouter, huggingface, claude, openai (override with LLM_PROVIDER_ORDER).

# --- Shared NVIDIA key (this one line covers ALL your NVIDIA models below) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
GOOGLE_2B_LLM=your_google_2b_key_here

# --- Other providers ---
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OPENAI_API_KEY=your_openai_or_nvidia_openai_compat_key_here

# --- Optional: only fill these in if you want a specific model on a
#     SEPARATE NVIDIA key instead of sharing NVIDIA_API_KEY above ---
NVIDIA_GLM_API_KEY=
NVIDIA_GEMMA2_API_KEY=
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_STEPFLASH_API_KEY=
NVIDIA_MISTRAL_API_KEY=
NVIDIA_MIXTRAL_API_KEY=
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_DEEPSEEK_PRO_API_KEY=
NVIDIA_LLAMA32_1B_API_KEY=
NVIDIA_LLAMA33_API_KEY=
NVIDIA_LLAMA31_70B_API_KEY=
NVIDIA_LLAMA31_8B_API_KEY=
NVIDIA_LLAMA32_3B_API_KEY=
NVIDIA_LLAMA34_1B_API_KEY=
NVIDIA_DIFFGEMMA_API_KEY=

# --- Database ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./aimaster.db

# --- JWT ---
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_own_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Model Paths ---
MODEL_CACHE_DIR=./models
CHECKPOINT_DIR=./checkpoints

# --- Local model (offline, no API key needed) ---
# Set to true to enable a real pretrained model as the last-resort
# fallback provider, after all cloud providers above. First call
# downloads the model from HuggingFace (~1GB for the default) and
# caches it - can take a while and needs a few GB free RAM to run.
ENABLE_LOCAL_MODEL=false
LOCAL_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# --- RAG (app/backend/rag_service.py) ---
# Where per-user Chroma collections are persisted to disk.
CHROMA_PERSIST_DIR=./chroma_db

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# --- CORS ---
# Comma-separated allowed origins. Leave unset to allow all (fine for
# local dev). Set before deploying publicly, e.g.:
# CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=
